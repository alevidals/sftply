---
const capabilities = [
  {
    label: "Protocols",
    detail: "FTP, FTPS and SFTP. Passive, extended passive and active channels.",
  },
  {
    label: "Networking",
    detail: "Native Rust. TLS pins, strict SSH host keys, no system binaries.",
  },
  {
    label: "Queue",
    detail: "Progress, speed and errors per file. Resume only when supported.",
  },
  {
    label: "Compare",
    detail:
      "Dry-run diff in both directions, with include/exclude globs and content checks.",
  },
  {
    label: "Preview",
    detail:
      "Read-only text and raster images without downloading. HTML and SVG never run.",
  },
  {
    label: "Deletes",
    detail:
      "Target-only items go only through a separate confirmation. Sync never deletes.",
  },
  {
    label: "Secrets",
    detail: "Passwords stay in the OS keychain, never in config or logs.",
  },
  {
    label: "Editor",
    detail: "UTF-8 up to 2 MiB. Atomic saves and stale-write detection.",
  },
  {
    label: "Permissions",
    detail: "Octal and symbolic modes, with per-entry errors.",
  },
  {
    label: "Themes",
    detail: "Dark, light and named palettes, contrast-tested.",
  },
];
---

<section class="section features" id="features">
  <div class="container">
    <div class="section-head">
      <h2>Built for moving files, not for fighting the client.</h2>
    </div>

    <dl class="spec-list">
      {
        capabilities.map((capability) => (
          <div class="spec-row">
            <dt>{capability.label}</dt>
            <dd set:html={capability.detail} />
          </div>
        ))
      }
    </dl>
  </div>
</section>
