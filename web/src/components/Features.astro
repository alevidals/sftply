---
import type { IconName } from "../lib/icons"
import Icon from "./Icon.astro"

interface Feature {
  icon: IconName
  title: string
  body: string
}

const features: Feature[] = [
  {
    icon: "arrow-right-left",
    title: "Two panes, one flow",
    body: "Local and remote folders side by side. Multi-select, drag across panes, and the destination refreshes as soon as the transfer completes.",
  },
  {
    icon: "network",
    title: "FTP, explicit and implicit FTPS, SFTP",
    body: "One client for the protocols you actually meet. TLS for FTPS, SSH host keys for SFTP, and no shelling out to system binaries.",
  },
  {
    icon: "list-checks",
    title: "A queue that tells the truth",
    body: "Per-file progress, speed and errors in one panel. Pause and resume appear only when the server can honour them.",
  },
  {
    icon: "key-round",
    title: "Secrets stay in the keychain",
    body: "Passwords and passphrases live in the OS keychain. Saved connections, exports and logs never contain them.",
  },
  {
    icon: "file-pen",
    title: "Edit remote text files",
    body: "Open a UTF-8 file in place, edit it, save atomically. Stale writes are detected instead of silently overwriting someone else's changes.",
  },
  {
    icon: "palette",
    title: "Dark, light and named palettes",
    body: "Dark by default, light as a first-class mode, plus curated palettes. Every theme is contrast-tested, including focus rings.",
  },
]

const shortcuts = [
  { keys: "⌘K", label: "Command palette" },
  { keys: "⌘1", label: "Local pane" },
  { keys: "⌘2", label: "Remote pane" },
  { keys: "⌘J", label: "Transfers" },
  { keys: "⌘L", label: "Edit path" },
]
---

<section class="section" id="features">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">What's inside</p>
      <h2>Built for moving files, not for fighting the client</h2>
      <p class="lead">
        Every pane, dialog and shortcut serves one loop: pick files, move them, see
        exactly what happened.
      </p>
    </div>

    <div class="card-grid">
      {
        features.map((feature) => (
          <article class="card">
            <div class="card-icon">
              <Icon name={feature.icon} size={18} />
            </div>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))
      }
    </div>

    <ul class="shortcut-strip" aria-label="Keyboard shortcuts">
      <li class="shortcut-strip-label">Keyboard first</li>
      {
        shortcuts.map((shortcut) => (
          <li class="shortcut">
            <kbd>{shortcut.keys}</kbd>
            <span>{shortcut.label}</span>
          </li>
        ))
      }
      <li class="shortcut-strip-note">Ctrl on Windows and Linux</li>
    </ul>
  </div>
</section>
