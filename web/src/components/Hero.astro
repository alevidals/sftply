---
import heroDark from "../assets/screens/hero-dark.webp";
import heroDetail from "../assets/screens/hero-detail.webp";
import { REPO_URL } from "../lib/releases";
---

<section class="hero container">
  <div class="hero-copy">
    <h1>FTP, FTPS and SFTP, without the friction.</h1>
    <p class="hero-sentence">
      Free and open source, with native Rust networking and an honest queue.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#download">Download for desktop</a>
      <a class="btn btn-ghost" href={REPO_URL}>View source</a>
    </div>
    <p class="hero-platform">macOS, Windows and Linux. MIT licensed.</p>
  </div>

  <figure class="hero-visual">
    <picture>
      <source media="(max-width: 700px)" srcset={heroDetail.src} />
      <img
        src={heroDark.src}
        width={heroDark.width}
        height={heroDark.height}
        alt="sftply with a local folder on the left, a remote FTP folder on the right and an upload in the transfer queue"
        fetchpriority="high"
      />
    </picture>
  </figure>
</section>
