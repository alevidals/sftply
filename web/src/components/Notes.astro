---
import { REPO_URL } from "../lib/releases";

const questions = [
  {
    title: "Is it really free?",
    body: "MIT licensed. Use, modify and redistribute.",
  },
  {
    title: "macOS warning on first launch?",
    body: "Ad-hoc signed. Right-click and Open.",
  },
  {
    title: "What about Windows and Linux?",
    body: "Windows needs WebView2. Linux may need FUSE 2 and WebKitGTK.",
  },
  {
    title: "Sync or directory diff?",
    body: "Not in 1.0. A dry-run sync is planned for 1.1.",
  },
];
---

<section class="section section--tight faq-section" id="questions">
  <div class="container">
    <div class="section-head">
      <h2>Before you install.</h2>
    </div>

    <div class="faq-grid">
      {
        questions.map((question) => (
          <article class="faq-item">
            <h3>{question.title}</h3>
            <p>{question.body}</p>
          </article>
        ))
      }
    </div>

    <p class="download-meta">
      <span>Source and release notes on GitHub.</span>
      <a href={REPO_URL}>github.com/alevidals/sftply</a>
      <a href={`${REPO_URL}/blob/main/docs/USER_GUIDE.md`}>User guide</a>
    </p>
  </div>
</section>
