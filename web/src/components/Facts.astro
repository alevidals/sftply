---
const facts = [
  { label: "Protocols", value: "FTP · FTPS · SFTP" },
  { label: "Networking", value: "Native Rust" },
  { label: "Credentials", value: "OS keychain" },
  { label: "Builds", value: "Portable, no install" },
];
---

<div class="facts">
  <dl class="container">
    {
      facts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))
    }
  </dl>
</div>
