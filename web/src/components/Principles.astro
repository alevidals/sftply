---
import { REPO_URL } from "../lib/releases";

const principles = [
  {
    title: "Pause and resume only when the server supports it.",
    body: "A restart is reported.",
  },
  {
    title: "Host keys are verified, never trusted silently.",
    body: "Unknown keys fail closed.",
  },
  {
    title: "Credentials never leave the keychain.",
    body: "Exports and logs never include secrets.",
  },
];
---

<section class="section section--roomy principles" id="principles">
  <div class="container">
    <div>
      <h2>A queue that tells the truth.</h2>
      <blockquote class="principles-quote">
        A transfer queue is a promise. No resume button the server cannot honour.
      </blockquote>
      <a class="principles-link" href={`${REPO_URL}/blob/main/docs/ARCHITECTURE.md`}>
        Architecture notes
      </a>
    </div>

    <ol class="principle-list">
      {
        principles.map((principle) => (
          <li>
            <strong>{principle.title}</strong>
            <span>{principle.body}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>
