---
import "../styles/global.css";
import { Font } from "astro:assets";
import Brand from "../components/Brand.astro";
import Icon from "../components/Icon.astro";
import mark from "../assets/mark.svg?url";
import { REPO_URL, RELEASES_URL } from "../lib/releases";

interface Props {
  title: string;
  description: string;
  image?: string;
  version?: string;
  downloadUrl?: string;
}

const { title, description, image, version, downloadUrl } = Astro.props;
const origin = Astro.site ?? "https://alevidals.github.io";
const canonical = new URL(Astro.url.pathname, origin).href;
const imageUrl = image ? new URL(image, origin).href : undefined;

const software = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "sftply",
  description:
    "A free, open-source FTP, FTPS and SFTP client for macOS, Windows and Linux.",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "macOS, Windows, Linux",
  url: canonical,
  downloadUrl: downloadUrl ?? canonical,
  softwareVersion: version,
  license: "https://opensource.org/license/mit",
  sameAs: [REPO_URL],
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  screenshot: imageUrl,
  inLanguage: "en",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={mark} type="image/svg+xml" />
    <meta name="theme-color" id="theme-color" content="#f5f6f8" />
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("sftply-theme");
        } catch {
          /* storage can be unavailable in restricted contexts */
        }
        const theme =
          stored === "light" || stored === "dark"
            ? stored
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.dataset.theme = theme;
        const meta = document.getElementById("theme-color");
        if (meta) meta.content = theme === "dark" ? "#101218" : "#f5f6f8";
      })();
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="sftply" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta name="application-name" content="sftply" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:type" content="image/jpeg" />}
    {imageUrl && <meta property="og:image:width" content="1200" />}
    {imageUrl && <meta property="og:image:height" content="630" />}
    {imageUrl && <meta property="og:image:alt" content="sftply, an FTP, FTPS and SFTP client for the desktop" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {imageUrl && <meta name="twitter:image:alt" content="sftply, an FTP, FTPS and SFTP client for the desktop" />}
    <script type="application/ld+json" set:html={JSON.stringify(software)} />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-work-sans" preload />
    <Font cssVariable="--font-jetbrains-mono" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" id="site-header">
      <div class="container">
        <Brand />
        <nav class="site-nav" aria-label="Main">
          <a class="nav-link" href="#features">Features</a>
          <a class="nav-link" href="#interface">Interface</a>
          <a class="nav-link" href={`${REPO_URL}/tree/main/docs`}>Docs</a>
          <a class="nav-link" href="#questions">FAQ</a>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme">
            <span class="theme-icon theme-icon-moon"><Icon name="moon" size={16} /></span>
            <span class="theme-icon theme-icon-sun"><Icon name="sun" size={16} /></span>
          </button>
          <a class="nav-cta" href="#download">Download</a>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <Brand />
        <ul class="footer-links">
          <li><a href={REPO_URL}>Source</a></li>
          <li><a href={RELEASES_URL}>All releases</a></li>
          <li><a href={`${REPO_URL}/tree/main/docs`}>Docs</a></li>
          <li><a href={`${REPO_URL}/blob/main/LICENSE`}>MIT license</a></li>
        </ul>
        <p class="footer-note">
          Built with Tauri 2, React and Rust · unsigned builds, verify SHA256SUMS · © {
            new Date().getFullYear()
          } sftply
        </p>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const header = document.getElementById("site-header");
        const onScroll = () => header?.toggleAttribute("data-scrolled", window.scrollY > 8);
        onScroll();
        addEventListener("scroll", onScroll, { passive: true });
      })();
    </script>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.getElementById("theme-toggle");
        const meta = document.getElementById("theme-color");
        const media = matchMedia("(prefers-color-scheme: dark)");

        const apply = (theme) => {
          const dark = theme === "dark";
          root.dataset.theme = theme;
          button?.setAttribute(
            "aria-label",
            dark ? "Switch to light theme" : "Switch to dark theme",
          );
          if (meta) meta.content = dark ? "#101218" : "#f5f6f8";
        };

        apply(root.dataset.theme === "dark" ? "dark" : "light");

        button?.addEventListener("click", () => {
          const next = root.dataset.theme === "dark" ? "light" : "dark";
          try {
            localStorage.setItem("sftply-theme", next);
          } catch {
            /* the theme still applies for this visit */
          }
          apply(next);
        });

        media.addEventListener("change", (event) => {
          let stored = null;
          try {
            stored = localStorage.getItem("sftply-theme");
          } catch {
            /* ignore */
          }
          if (!stored) apply(event.matches ? "dark" : "light");
        });
      })();
    </script>
  </body>
</html>
