---
import Base from "../layouts/Base.astro";
import Downloads from "../components/Downloads.astro";
import Facts from "../components/Facts.astro";
import Features from "../components/Features.astro";
import Hero from "../components/Hero.astro";
import Interface from "../components/Interface.astro";
import Notes from "../components/Notes.astro";
import Principles from "../components/Principles.astro";
import { loadRelease } from "../lib/releases";

const release = await loadRelease();

console.info(
  release.live
    ? `[site] using release v${release.version} with ${release.assets.length} assets`
    : `[site] offline build, linking to the latest release page for v${release.version}`,
);

const title = "sftply — FTP, FTPS and SFTP client";
const description =
  "A free, open-source FTP, FTPS and SFTP client for macOS, Windows and Linux. Dual panes, keychain credentials and an honest transfer queue.";
const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const image = `${basePath}og-image.jpg`;
---

<Base
  title={title}
  description={description}
  image={image}
  version={release.version}
  downloadUrl={release.url}
>
  <Hero version={release.version} />
  <Facts />
  <Features />
  <Interface />
  <Principles />
  <Downloads release={release} />
  <Notes />
</Base>
