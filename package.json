{
  "name": "sftply",
  "private": true,
  "version": "0.4.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bindings": "cd src-tauri && cargo run --example export-bindings",
    "rust:check": "cd src-tauri && cargo check --all-targets",
    "rust:test": "cd src-tauri && cargo test",
    "rust:lint": "cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings",
    "dev:ftp": "docker compose -f docker/dev-ftp/docker-compose.yml up -d --build",
    "dev:ftp:down": "docker compose -f docker/dev-ftp/docker-compose.yml down",
    "dev:ftp:logs": "docker compose -f docker/dev-ftp/docker-compose.yml logs -f ftp",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "version:check": "bun scripts/check-versions.ts",
    "web:dev": "cd web && bun run dev",
    "web:build": "cd web && bun run build",
    "web:check": "cd web && bun run check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^7.0.3",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.69.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.18.1",
    "sonner": "^2.0.8",
    "tinykeys": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
